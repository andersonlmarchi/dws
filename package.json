{
  "name": "dws",
  "version": "1.0.0",
  "description": "A CLI tool that helps developers switch between Docker-based development workspaces with a single command.",
  "main": "index.js",
  "engines": {
    "node": "24.11.0",
    "npm": "11.11.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier . --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andersonlmarchi/dws.git"
  },
  "bin": {
    "dws": "./dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/andersonlmarchi/dws/issues"
  },
  "homepage": "https://github.com/andersonlmarchi/dws#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "figlet": "^1.11.0"
  }
}
